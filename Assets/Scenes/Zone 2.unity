    - target: {fileID: 7387578115882616764, guid: f3b590ffb20076247973615a0f67cece,
        type: 3}
      propertyPath: name
      value: "Qiubo, la nost\xE1lgica"
      objectReference: {fileID: 0}
    - target: {fileID: 7387578115882616764, guid: f3b590ffb20076247973615a0f67cece,
        type: 3}
      propertyPath: npcName
      value: 
      objectReference: {fileID: 1980048405}
    - target: {fileID: 7387578115882616764, guid: f3b590ffb20076247973615a0f67cece,
        type: 3}
      propertyPath: dialogueName
      value: 
      objectReference: {fileID: 1980048407}
    - target: {fileID: 7387578115882616764, guid: f3b590ffb20076247973615a0f67cece,
        type: 3}
      propertyPath: dialogueText
      value: 
      objectReference: {fileID: 1980048408}
    - target: {fileID: 7387578115882616764, guid: f3b590ffb20076247973615a0f67cece,
        type: 3}
      propertyPath: dialoguePanel
      value: 
      objectReference: {fileID: 1980048409}
    - target: {fileID: 7387578115882616764, guid: f3b590ffb20076247973615a0f67cece,
        type: 3}
      propertyPath: message.Array.data[0]
      value: "\xA1Ay, qu\xE9 tiempos! Todav\xEDa me acuerdo de cuando visit\xE9 la
        gran aldea."
      objectReference: {fileID: 0}
    - target: {fileID: 7387578115882616764, guid: f3b590ffb20076247973615a0f67cece,
        type: 3}
      propertyPath: message.Array.data[1]
      value: "Quer\xEDa visitar el templo, pero me pill\xF3 en reformas. Dec\xEDan
        algo de que hab\xEDan perdido el amuleto."
      objectReference: {fileID: 0}
    - target: {fileID: 7387578115882616764, guid: f3b590ffb20076247973615a0f67cece,
        type: 3}
      propertyPath: message.Array.data[2]
      value: "Bueno, por lo menos tuve 100 w\xE9ns y me compr\xE9 un huevo centenario."
      objectReference: {fileID: 0}
    m_RemovedComponents: []
    m_RemovedGameObjects: []
    m_AddedGameObjects: []
    m_AddedComponents: []
  m_SourcePrefab: {fileID: 100100000, guid: f3b590ffb20076247973615a0f67cece, type: 3}
--- !u!1001 &1301628028
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 539080475}
    m_Modifications:
    - target: {fileID: 2298563219558475413, guid: 59d7a06f8b2320e4bbb6c395b8540d46,
        type: 3}
      propertyPath: name
      value: "Maozen, el otro charlat\xE1n"
      objectReference: {fileID: 0}
    - target: {fileID: 2298563219558475413, guid: 59d7a06f8b2320e4bbb6c395b8540d46,
        type: 3}
      propertyPath: npcName
      value: 
      objectReference: {fileID: 1980048405}
    - target: {fileID: 2298563219558475413, guid: 59d7a06f8b2320e4bbb6c395b8540d46,
        type: 3}
      propertyPath: dialogueName
      value: 
      objectReference: {fileID: 1980048407}
    - target: {fileID: 2298563219558475413, guid: 59d7a06f8b2320e4bbb6c395b8540d46,
        type: 3}
      propertyPath: dialogueText
      value: 
      objectReference: {fileID: 1980048408}
    - target: {fileID: 2298563219558475413, guid: 59d7a06f8b2320e4bbb6c395b8540d46,
        type: 3}
      propertyPath: characterType
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 2298563219558475413, guid: 59d7a06f8b2320e4bbb6c395b8540d46,
        type: 3}
      propertyPath: dialoguePanel
      value: 
      objectReference: {fileID: 1980048409}
    - target: {fileID: 2298563219558475413, guid: 59d7a06f8b2320e4bbb6c395b8540d46,
        type: 3}
      propertyPath: message.Array.size
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 2298563219558475413, guid: 59d7a06f8b2320e4bbb6c395b8540d46,
        type: 3}
      propertyPath: message.Array.data[0]
      value: "\xA1Yo soy Maozen, guardi\xE1n de este templo!"
      objectReference: {fileID: 0}
    - target: {fileID: 2298563219558475413, guid: 59d7a06f8b2320e4bbb6c395b8540d46,
        type: 3}
      propertyPath: message.Array.data[1]
      value: "Te voy a contar una cosita \xBFSer\xE1 verdad o mentira?"
      objectReference: {fileID: 0}
    - target: {fileID: 2298563219558475413, guid: 59d7a06f8b2320e4bbb6c395b8540d46,
        type: 3}
      propertyPath: message.Array.data[2]
      value: "Ah\xED va: tenemos muchos curros."
      objectReference: {fileID: 0}
    - target: {fileID: 2298563219558475413, guid: 59d7a06f8b2320e4bbb6c395b8540d46,
        type: 3}
      propertyPath: message.Array.data[3]
      value: "Pero recuerda...el caos de este mundo no se acaba con m\xE1s caos,
        sino con el balance. "
      objectReference: {fileID: 0}
    - target: {fileID: 2298563219558475413, guid: 59d7a06f8b2320e4bbb6c395b8540d46,
        type: 3}
      propertyPath: message.Array.data[4]
      value: "[PULSA EL CLICK IZQUIERDO DEL RAT\xD3N PARA ATACAR]"
      objectReference: {fileID: 0}
    - target: {fileID: 2298563219558475413, guid: 59d7a06f8b2320e4bbb6c395b8540d46,
        type: 3}
      propertyPath: message.Array.data[5]
      value: "Cuando termines, \xA1ve al pueblo y busca a Mao-Mofa, la brujita! Te
        contar\xE1 m\xE1s al respecto."
      objectReference: {fileID: 0}
    - target: {fileID: 2962768359023847996, guid: 59d7a06f8b2320e4bbb6c395b8540d46,
        type: 3}
      propertyPath: m_IsActive
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 4763180460756662808, guid: 59d7a06f8b2320e4bbb6c395b8540d46,
        type: 3}
      propertyPath: m_Name
      value: Maozen
      objectReference: {fileID: 0}
    - target: {fileID: 5283258684578406562, guid: 59d7a06f8b2320e4bbb6c395b8540d46,
        type: 3}
