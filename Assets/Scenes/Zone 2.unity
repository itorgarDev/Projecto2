      propertyPath: dialoguePanel
      value: 
      objectReference: {fileID: 1980048409}
    - target: {fileID: 2298563219558475413, guid: 59d7a06f8b2320e4bbb6c395b8540d46,
        type: 3}
      propertyPath: message.Array.data[0]
      value: "Muchos dicen que la gran aldea tiene el mejor templo de estas islas.
        \xA1Bobadas!"
      objectReference: {fileID: 0}
    - target: {fileID: 2298563219558475413, guid: 59d7a06f8b2320e4bbb6c395b8540d46,
        type: 3}
      propertyPath: message.Array.data[1]
      value: "Sin duda alguna el que tengo a mis espaldas  le deja a la altura del
        bet\xFAn. Es incluso mejor que el templo del este."
      objectReference: {fileID: 0}
    - target: {fileID: 2298563219558475413, guid: 59d7a06f8b2320e4bbb6c395b8540d46,
        type: 3}
      propertyPath: message.Array.data[2]
      value: "\xBFQu\xE9 pasa? \xBFQuieres entrar? Lo siento, pero creo que no vas
        a poder... \xA1Eres demasiado grande como para caber!"
      objectReference: {fileID: 0}
    - target: {fileID: 4763180460756662808, guid: 59d7a06f8b2320e4bbb6c395b8540d46,
        type: 3}
      propertyPath: m_Name
      value: Maolinito
      objectReference: {fileID: 0}
