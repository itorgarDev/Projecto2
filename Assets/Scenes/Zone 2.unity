      propertyPath: dialoguePanel
      value: 
      objectReference: {fileID: 1980048409}
    - target: {fileID: 2791902480122742858, guid: 3e8a125eb3b269e498758f5720280a20,
        type: 3}
      propertyPath: message.Array.data[0]
      value: "\xA1Wow! Hemos llegado a la zona de los r\xEDos. Espera, que saco el
        mapa y te lo confirmo... \xA1Aj\xE1!"
      objectReference: {fileID: 0}
    - target: {fileID: 2791902480122742858, guid: 3e8a125eb3b269e498758f5720280a20,
        type: 3}
      propertyPath: message.Array.data[1]
      value: "Esta regi\xF3n es conocida por estar separada por islotes, por lo que
        los habitantes de aqu\xED han tenido que construir puentes para moverse.
        Quiz\xE1s te lleven a lugares interesantes."
      objectReference: {fileID: 0}
    - target: {fileID: 2791902480122742858, guid: 3e8a125eb3b269e498758f5720280a20,
        type: 3}
      propertyPath: message.Array.data[2]
      value: "Creo que cerca de aqu\xED hay un templo y por el este hay un templo
        al culto. \xA1Vayamos a la aldea!"
      objectReference: {fileID: 0}
    - target: {fileID: 5087535926102542268, guid: 3e8a125eb3b269e498758f5720280a20,
        type: 3}
      propertyPath: m_IsActive
      value: 0
      objectReference: {fileID: 0}
