      objectReference: {fileID: 1980048409}
    - target: {fileID: 3982378103086766949, guid: 7bda7107daff9034f9696f03bfdf9fbc,
        type: 3}
      propertyPath: message.Array.data[0]
      value: "\xA1Voy a ser una aventurera! Pero... no s\xE9 por donde empezar."
      objectReference: {fileID: 0}
    - target: {fileID: 3982378103086766949, guid: 7bda7107daff9034f9696f03bfdf9fbc,
        type: 3}
      propertyPath: message.Array.data[1]
      value: "Claro que quiero ser la protagonista de un relato que le contar\xE9
        a mis nietos. \xBFPero cu\xE1l es el primer paso?"
      objectReference: {fileID: 0}
    - target: {fileID: 3982378103086766949, guid: 7bda7107daff9034f9696f03bfdf9fbc,
        type: 3}
      propertyPath: message.Array.data[2]
      value: "Si tuviese a un h\xE9roe en frente de m\xED, se lo preguntar\xEDa.
        \xA1Ahora qu\xEDtate, que le sigo esperando!"
      objectReference: {fileID: 0}
