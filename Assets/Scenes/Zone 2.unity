    - target: {fileID: 1064292022973925825, guid: cad6e4bdb88e32b4cb49f462284420c8,
        type: 3}
      propertyPath: message.Array.data[0]
      value: "\xA1Otro! \xA1Ha picado otro! Madre m\xEDa, que gusto da pescar por
        estas tierras."
      objectReference: {fileID: 0}
    - target: {fileID: 1064292022973925825, guid: cad6e4bdb88e32b4cb49f462284420c8,
        type: 3}
      propertyPath: message.Array.data[1]
      value: "Me pregunto c\xF3mo le ir\xE1 a mi hermanito. Se fue a probar suerte
        al norte."
      objectReference: {fileID: 0}
    - target: {fileID: 1064292022973925825, guid: cad6e4bdb88e32b4cb49f462284420c8,
        type: 3}
      propertyPath: message.Array.data[2]
      value: "Aunque con el fr\xEDo que hace all\xED, dudo que pique algo. \xA1Cuidado,
        que ha vuelto a picar!"
      objectReference: {fileID: 0}
    - target: {fileID: 3654779574797105106, guid: cad6e4bdb88e32b4cb49f462284420c8,
        type: 3}
      propertyPath: m_Name
