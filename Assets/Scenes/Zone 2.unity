    - target: {fileID: 7824298905685332637, guid: 1b46ba543877b484ea0c973b5b81c757,
        type: 3}
      propertyPath: name
      value: Mao-Mofa, la brujilla
      objectReference: {fileID: 0}
    - target: {fileID: 7824298905685332637, guid: 1b46ba543877b484ea0c973b5b81c757,
        type: 3}
      propertyPath: npcName
      value: 
      objectReference: {fileID: 1980048405}
    - target: {fileID: 7824298905685332637, guid: 1b46ba543877b484ea0c973b5b81c757,
        type: 3}
      propertyPath: dialogueName
      value: 
      objectReference: {fileID: 1980048407}
    - target: {fileID: 7824298905685332637, guid: 1b46ba543877b484ea0c973b5b81c757,
        type: 3}
      propertyPath: dialogueText
      value: 
      objectReference: {fileID: 1980048408}
    - target: {fileID: 7824298905685332637, guid: 1b46ba543877b484ea0c973b5b81c757,
        type: 3}
      propertyPath: characterType
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 7824298905685332637, guid: 1b46ba543877b484ea0c973b5b81c757,
        type: 3}
      propertyPath: dialoguePanel
      value: 
      objectReference: {fileID: 1980048409}
    - target: {fileID: 7824298905685332637, guid: 1b46ba543877b484ea0c973b5b81c757,
        type: 3}
      propertyPath: message.Array.size
      value: 5
      objectReference: {fileID: 0}
    - target: {fileID: 7824298905685332637, guid: 1b46ba543877b484ea0c973b5b81c757,
        type: 3}
      propertyPath: message.Array.data[0]
      value: "\xA1Por fin nos encontramos de nuevo! Ya veo que te est\xE1 yendo bien
        por el mundo. Maostiao estar\xEDa orgulloso."
      objectReference: {fileID: 0}
    - target: {fileID: 7824298905685332637, guid: 1b46ba543877b484ea0c973b5b81c757,
        type: 3}
      propertyPath: message.Array.data[1]
      value: "\xA1No hay tiempo de elogios! Estamos cada vez m\xE1s cerca de conseguir
        nuestro cometido."
      objectReference: {fileID: 0}
    - target: {fileID: 7824298905685332637, guid: 1b46ba543877b484ea0c973b5b81c757,
        type: 3}
      propertyPath: message.Array.data[2]
      value: "Por el sur vive Zhuque, el ave. \xA1Ese celestial es el que nos tiene
        atrapados y el que ha bloqueado la entrada al templo del este!"
      objectReference: {fileID: 0}
    - target: {fileID: 7824298905685332637, guid: 1b46ba543877b484ea0c973b5b81c757,
        type: 3}
      propertyPath: message.Array.data[3]
      value: "\xA1Es raudo como el rayo! \xA1Vivo como el viento! \xA1Terrible como
        el trueno! \xA1Es capaz de partir los cielos!"
      objectReference: {fileID: 0}
    - target: {fileID: 7824298905685332637, guid: 1b46ba543877b484ea0c973b5b81c757,
        type: 3}
      propertyPath: message.Array.data[4]
      value: "\xA1\xC1ndate con mucho ojo y consigue recuperar la llave que abre
        el templo!"
      objectReference: {fileID: 0}
    m_RemovedComponents: []
    m_RemovedGameObjects: []
    m_AddedGameObjects: []
    m_AddedComponents: []
  m_SourcePrefab: {fileID: 100100000, guid: 1b46ba543877b484ea0c973b5b81c757, type: 3}
