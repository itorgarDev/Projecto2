    - target: {fileID: 1064292022973925825, guid: cad6e4bdb88e32b4cb49f462284420c8,
        type: 3}
      propertyPath: characterType
      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 1064292022973925825, guid: cad6e4bdb88e32b4cb49f462284420c8,
