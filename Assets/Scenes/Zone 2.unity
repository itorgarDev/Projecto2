    - target: {fileID: 2791902480122742858, guid: 3e8a125eb3b269e498758f5720280a20,
        type: 3}
      propertyPath: message.Array.data[0]
      value: Bienvenido, turista. Me temo que la visita al templo del este se va
        a tener que cancelar.
      objectReference: {fileID: 0}
    - target: {fileID: 2791902480122742858, guid: 3e8a125eb3b269e498758f5720280a20,
        type: 3}
      propertyPath: message.Array.data[1]
      value: "La puerta del templo ha sido bloqueada y no hay forma de acceder a
        \xE9l."
      objectReference: {fileID: 0}
    - target: {fileID: 2791902480122742858, guid: 3e8a125eb3b269e498758f5720280a20,
        type: 3}
      propertyPath: message.Array.data[2]
      value: "Si eso, regresa a la aldea, que quiz\xE1s podemos a organizar otra
        al templo del pueblo"
      objectReference: {fileID: 0}
