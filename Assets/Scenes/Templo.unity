      propertyPath: name
      value: Mao-Mofa, la brujita
      objectReference: {fileID: 0}
    - target: {fileID: 7824298905685332637, guid: 1b46ba543877b484ea0c973b5b81c757,
        type: 3}
      propertyPath: npcName
      value: 
      objectReference: {fileID: 48910943}
    - target: {fileID: 7824298905685332637, guid: 1b46ba543877b484ea0c973b5b81c757,
        type: 3}
      propertyPath: dialogueName
      value: 
      objectReference: {fileID: 48910944}
    - target: {fileID: 7824298905685332637, guid: 1b46ba543877b484ea0c973b5b81c757,
        type: 3}
      propertyPath: dialogueText
      value: 
      objectReference: {fileID: 48910945}
    - target: {fileID: 7824298905685332637, guid: 1b46ba543877b484ea0c973b5b81c757,
        type: 3}
      propertyPath: characterType
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 7824298905685332637, guid: 1b46ba543877b484ea0c973b5b81c757,
        type: 3}
      propertyPath: dialoguePanel
      value: 
      objectReference: {fileID: 48910946}
    - target: {fileID: 7824298905685332637, guid: 1b46ba543877b484ea0c973b5b81c757,
        type: 3}
      propertyPath: message.Array.size
      value: 5
      objectReference: {fileID: 0}
    - target: {fileID: 7824298905685332637, guid: 1b46ba543877b484ea0c973b5b81c757,
        type: 3}
      propertyPath: message.Array.data[0]
      value: "\xA1Por fin llegaste! Este templo es el lugar m\xE1s m\xE1gico del
        templo. Aunque est\xE9n enfadadas, las diosas todav\xEDan lo siguen bendiciendo."
      objectReference: {fileID: 0}
    - target: {fileID: 7824298905685332637, guid: 1b46ba543877b484ea0c973b5b81c757,
        type: 3}
      propertyPath: message.Array.data[1]
      value: "...D\xE9jame mirar tu arma...\xA1Jam\xE1s  hab\xEDa visto algo parecido!
        Parece un regalo divino."
      objectReference: {fileID: 0}
    - target: {fileID: 7824298905685332637, guid: 1b46ba543877b484ea0c973b5b81c757,
        type: 3}
      propertyPath: message.Array.data[2]
      value: "Si es as\xED, posee el don del balance, el de liberar a los ca\xF3ticos
        que acechan estas islas sin da\xF1arlos."
      objectReference: {fileID: 0}
    - target: {fileID: 7824298905685332637, guid: 1b46ba543877b484ea0c973b5b81c757,
        type: 3}
      propertyPath: message.Array.data[3]
      value: "Si consigues estar en armon\xEDa con ella, ser\xE1s invencible...\xBFtal
        vez para hablar con las diosas? \xA1Solo habr\xE1 que probarlo!"
      objectReference: {fileID: 0}
    - target: {fileID: 7824298905685332637, guid: 1b46ba543877b484ea0c973b5b81c757,
        type: 3}
      propertyPath: message.Array.data[4]
      value: "\xA1Adelante! Sal al mundo e intenta llegar al norte. Eres nuestra
        \xFAltima esperanza."
      objectReference: {fileID: 0}
    m_RemovedComponents: []
    m_RemovedGameObjects: []
    m_AddedGameObjects: []
    m_AddedComponents: []
  m_SourcePrefab: {fileID: 100100000, guid: 1b46ba543877b484ea0c973b5b81c757, type: 3}
