  dialogueName: {fileID: 0}
  npcName: {fileID: 0}
  name: Qiuro, el indirecto
  message:
  - "\xA1Ho\u2026hola! Lo siento, pero ahora no puedo estar contigo."
  - "Es que\u2026 Maolina\u2026hoy est\xE1 muy guapa\u2026"
  - "\xA1Ahhh! \xA1No-no-no quer\xEDa decir eso! Maldita sea."
  - "Pero es que no puedo dejar de mirarla\u2026"
