      propertyPath: dialoguePanel
      value: 
      objectReference: {fileID: 1528339463}
    - target: {fileID: 7824298905685332637, guid: 1b46ba543877b484ea0c973b5b81c757,
        type: 3}
      propertyPath: message.Array.data[0]
      value: "\xA1Guerrero! Has conseguido llegar muy lejos. \xA1Ya casi est\xE1s!"
      objectReference: {fileID: 0}
    - target: {fileID: 7824298905685332637, guid: 1b46ba543877b484ea0c973b5b81c757,
        type: 3}
      propertyPath: message.Array.data[1]
      value: "A la cima de la monta\xF1a, se encuentra Xuanwu, el celestial del norte."
      objectReference: {fileID: 0}
    - target: {fileID: 7824298905685332637, guid: 1b46ba543877b484ea0c973b5b81c757,
        type: 3}
      propertyPath: message.Array.data[2]
      value: "\xA1Que no te enga\xF1en sus dos cabezas! La serpiente hablar\xE1 m\xE1s
        e intentar\xE1 seducirte. \xA1Consigue resistir! \xA1\xC1nimo!"
      objectReference: {fileID: 0}
