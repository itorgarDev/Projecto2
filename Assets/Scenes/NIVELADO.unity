      propertyPath: message.Array.size
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 7629302584185032616, guid: 7911768a63052254fafce981adceeb8a,
        type: 3}
      propertyPath: message.Array.data[0]
      value: "\xA1Wow! A las puertas del pueblo, tenemos a Maostiao, nuestro mejor
        guerrero. Creo que lo mejor es usar las palabras\u2026pero por si acaso..."
      objectReference: {fileID: 0}
    - target: {fileID: 7629302584185032616, guid: 7911768a63052254fafce981adceeb8a,
        type: 3}
      propertyPath: message.Array.data[1]
      value: "\xA1Ve a hablar con \xE9l! Puede que te ense\xF1e alg\xFAn que otro
        truquito."
      objectReference: {fileID: 0}
    - target: {fileID: 7629302584185032616, guid: 7911768a63052254fafce981adceeb8a,
        type: 3}
      propertyPath: message.Array.data[2]
      value: "\xA1Pero no te preocupes! Que en mis ratos libres soy cart\xF3grafo.
        Quiz\xE1s estos papeles podr\xE1n serte \xFAtiles"
      objectReference: {fileID: 0}
    - target: {fileID: 7629302584185032616, guid: 7911768a63052254fafce981adceeb8a,
        type: 3}
      propertyPath: message.Array.data[3]
      value: '[PULSA LAS TECLA M PARA ABRIR EL MAPA]'
      objectReference: {fileID: 0}
