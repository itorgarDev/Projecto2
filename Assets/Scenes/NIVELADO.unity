        type: 3}
      propertyPath: message.Array.data[0]
      value: "\xA1Eh t\xFA! \xBFHas visto la muralla que hay a las afueras?"
      objectReference: {fileID: 0}
    - target: {fileID: 5604646733267574496, guid: db6828e52ecdccc4db2f84ba46e55a4f,
        type: 3}
      propertyPath: message.Array.data[1]
      value: "Dicen que all\xED vive una criatura de dos cabezas espeluznante."
      objectReference: {fileID: 0}
    - target: {fileID: 5604646733267574496, guid: db6828e52ecdccc4db2f84ba46e55a4f,
        type: 3}
      propertyPath: message.Array.data[2]
      value: "Pero eso dicen. No s\xE9, no fui muy buena en clases de historia."
      objectReference: {fileID: 0}
