    - target: {fileID: 7629302584185032616, guid: 7911768a63052254fafce981adceeb8a,
        type: 3}
      propertyPath: message.Array.data[1]
      value: "Aunque no lo parezca, estas islas son demasiado grandes y es muy f\xE1cil
        perderse."
      objectReference: {fileID: 0}
    - target: {fileID: 7629302584185032616, guid: 7911768a63052254fafce981adceeb8a,
        type: 3}
      propertyPath: message.Array.data[2]
      value: "\xA1Pero no te preocupes! Que en mis ratos libres soy cart\xF3grafo.
        Quiz\xE1s estos papeles podr\xE1n serte \xFAtiles"
      objectReference: {fileID: 0}
    - target: {fileID: 7629302584185032616, guid: 7911768a63052254fafce981adceeb8a,
