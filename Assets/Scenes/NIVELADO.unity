      propertyPath: dialoguePanel
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 7387578115882616764, guid: f3b590ffb20076247973615a0f67cece,
        type: 3}
      propertyPath: message.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 7387578115882616764, guid: f3b590ffb20076247973615a0f67cece,
        type: 3}
      propertyPath: message.Array.data[0]
      value: "\xA1Bienvenido a la villa, hermano! Un lugar chiquitito, pero que se
        alimenta de sue\xF1os y esperanzas."
      objectReference: {fileID: 0}
    - target: {fileID: 7387578115882616764, guid: f3b590ffb20076247973615a0f67cece,
        type: 3}
      propertyPath: message.Array.data[1]
      value: "Si te port\xE1is bien, pod\xE9is considerarnos vuestros amigos."
      objectReference: {fileID: 0}
    - target: {fileID: 7387578115882616764, guid: f3b590ffb20076247973615a0f67cece,
        type: 3}
      propertyPath: message.Array.data[2]
      value: "\xBFA qu\xE9 se debe vuestra visita? Espero que sea duradera."
      objectReference: {fileID: 0}
    - target: {fileID: 7387578115882616764, guid: f3b590ffb20076247973615a0f67cece,
        type: 3}
      propertyPath: message.Array.data[3]
      value: "Aunque si no vais a estar mucho tiempo, ten\xE9is que entrar s\xED
        o s\xED en el templo."
      objectReference: {fileID: 0}
    m_RemovedComponents: []
    m_RemovedGameObjects: []
    m_AddedGameObjects: []
    m_AddedComponents: []
