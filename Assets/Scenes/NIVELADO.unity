      value: "El caos podr\xE1 ser fuerte, pero solo puede destruir. \xBFQui\xE9n
        querr\xEDa tener una maldici\xF3n as\xED?"
      objectReference: {fileID: 0}
    - target: {fileID: 2298563219558475413, guid: 59d7a06f8b2320e4bbb6c395b8540d46,
        type: 3}
      propertyPath: message.Array.data[1]
      value: "Pero el resto de nosotros podemos... \xA1NO! \xA1Vamos a crear!"
      objectReference: {fileID: 0}
    - target: {fileID: 2298563219558475413, guid: 59d7a06f8b2320e4bbb6c395b8540d46,
        type: 3}
      propertyPath: message.Array.data[2]
      value: Y para ello, necesitamos encontrar el balance de la vida.
      objectReference: {fileID: 0}
    - target: {fileID: 2298563219558475413, guid: 59d7a06f8b2320e4bbb6c395b8540d46,
        type: 3}
      propertyPath: message.Array.data[3]
      value: "\xA1Adelante! Ya casi no queda nada."
      objectReference: {fileID: 0}
    - target: {fileID: 4763180460756662808, guid: 59d7a06f8b2320e4bbb6c395b8540d46,
        type: 3}
