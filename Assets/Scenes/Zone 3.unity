        type: 3}
      propertyPath: message.Array.data[0]
      value: "\xA1Mequetrefe! \xBFC\xF3mo se te puede ocurrir semejante estupidez?"
      objectReference: {fileID: 0}
    - target: {fileID: 1064292022973925825, guid: cad6e4bdb88e32b4cb49f462284420c8,
        type: 3}
      propertyPath: message.Array.data[1]
      value: "Mira que a qui\xE9n se le ocurre vender abrigos de piel. No ser\xEDa
        una mala idea\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 1064292022973925825, guid: cad6e4bdb88e32b4cb49f462284420c8,
        type: 3}
      propertyPath: message.Array.data[2]
      value: "\xA1Si no fuese porque todos somos peluditos!"
      objectReference: {fileID: 0}
    - target: {fileID: 1064292022973925825, guid: cad6e4bdb88e32b4cb49f462284420c8,
        type: 3}
      propertyPath: message.Array.data[3]
      value: "Si ya me lo dijo mi hermano mayor. \xBFLe conoces?"
      objectReference: {fileID: 0}
    - target: {fileID: 3654779574797105106, guid: cad6e4bdb88e32b4cb49f462284420c8,
        type: 3}
      propertyPath: m_Name
