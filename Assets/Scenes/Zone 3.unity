      objectReference: {fileID: 1922614464}
    - target: {fileID: 3982378103086766949, guid: 7bda7107daff9034f9696f03bfdf9fbc,
        type: 3}
      propertyPath: message.Array.data[0]
      value: "\xA1Eh t\xFA! \xBFHas visto la muralla que hay a las afueras? Es la
        Gran Maoralla."
      objectReference: {fileID: 0}
    - target: {fileID: 3982378103086766949, guid: 7bda7107daff9034f9696f03bfdf9fbc,
        type: 3}
      propertyPath: message.Array.data[1]
      value: "Dicen que all\xED vive una criatura de dos cabezas espeluznante."
      objectReference: {fileID: 0}
    - target: {fileID: 3982378103086766949, guid: 7bda7107daff9034f9696f03bfdf9fbc,
        type: 3}
      propertyPath: message.Array.data[2]
      value: "Pero eso dicen. No s\xE9, nunca fui muy buena en clases de historia."
      objectReference: {fileID: 0}
