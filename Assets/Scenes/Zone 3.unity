    - target: {fileID: 1064292022973925825, guid: cad6e4bdb88e32b4cb49f462284420c8,
        type: 3}
      propertyPath: message.Array.data[1]
      value: "Ojal\xE1 tener suficientes w\xE9ns para mudarme a la gran aldea."
      objectReference: {fileID: 0}
    - target: {fileID: 1064292022973925825, guid: cad6e4bdb88e32b4cb49f462284420c8,
        type: 3}
      propertyPath: message.Array.data[2]
      value: "A ver si viene alg\xFAn cliente."
      objectReference: {fileID: 0}
    - target: {fileID: 1064292022973925825, guid: cad6e4bdb88e32b4cb49f462284420c8,
        type: 3}
      propertyPath: message.Array.data[3]
      value: "Si ya me lo dijo mi hermano mayor. \xBFLe conoces?"
