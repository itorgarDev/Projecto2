      propertyPath: name
      value: Maostiao, el guerrero
      objectReference: {fileID: 0}
    - target: {fileID: 2298563219558475413, guid: 59d7a06f8b2320e4bbb6c395b8540d46,
        type: 3}
      propertyPath: npcName
      value: 
      objectReference: {fileID: 1922614461}
    - target: {fileID: 2298563219558475413, guid: 59d7a06f8b2320e4bbb6c395b8540d46,
        type: 3}
      propertyPath: dialogueName
      value: 
      objectReference: {fileID: 1922614462}
    - target: {fileID: 2298563219558475413, guid: 59d7a06f8b2320e4bbb6c395b8540d46,
        type: 3}
      propertyPath: dialogueText
      value: 
      objectReference: {fileID: 1922614463}
    - target: {fileID: 2298563219558475413, guid: 59d7a06f8b2320e4bbb6c395b8540d46,
        type: 3}
      propertyPath: dialoguePanel
      value: 
      objectReference: {fileID: 1922614464}
    - target: {fileID: 2298563219558475413, guid: 59d7a06f8b2320e4bbb6c395b8540d46,
        type: 3}
      propertyPath: message.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 2298563219558475413, guid: 59d7a06f8b2320e4bbb6c395b8540d46,
        type: 3}
      propertyPath: message.Array.data[0]
      value: "\xA1Guerrero! Has llegado muy lejos. Estoy orgulloso de ti."
      objectReference: {fileID: 0}
    - target: {fileID: 2298563219558475413, guid: 59d7a06f8b2320e4bbb6c395b8540d46,
        type: 3}
      propertyPath: message.Array.data[1]
      value: "M\xE1s orgulloso estoy de que hayas conseguido  encontrar el verdadero
        valor del balance."
      objectReference: {fileID: 0}
    - target: {fileID: 2298563219558475413, guid: 59d7a06f8b2320e4bbb6c395b8540d46,
        type: 3}
      propertyPath: message.Array.data[2]
      value: "Xuanwu y sus dos cabezas no te lo van a poner f\xE1cil... \xA1pero
        todos contamos contigo! Necesitamos que erradiques el caos de este mundo."
      objectReference: {fileID: 0}
    - target: {fileID: 2298563219558475413, guid: 59d7a06f8b2320e4bbb6c395b8540d46,
        type: 3}
