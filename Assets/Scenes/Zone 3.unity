    - target: {fileID: 2298563219558475413, guid: 59d7a06f8b2320e4bbb6c395b8540d46,
        type: 3}
      propertyPath: message.Array.data[1]
      value: "Te contar\xE9 una cosita: \xBFser\xE1 mentira o verdad?"
      objectReference: {fileID: 0}
    - target: {fileID: 2298563219558475413, guid: 59d7a06f8b2320e4bbb6c395b8540d46,
        type: 3}
      propertyPath: message.Array.data[2]
      value: "Ah\xED va: detr\xE1s de los mu\xF1ecos no hay ning\xFAn \xEDtem que
        te ayude en tu cruzada."
