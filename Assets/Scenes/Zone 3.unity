    - target: {fileID: 2298563219558475413, guid: 59d7a06f8b2320e4bbb6c395b8540d46,
        type: 3}
      propertyPath: message.Array.data[0]
      value: "Y si ya has llegado hasta aqu\xED, \xBFser\xE1s que has conseguido
        ese balance?"
      objectReference: {fileID: 0}
    - target: {fileID: 2298563219558475413, guid: 59d7a06f8b2320e4bbb6c395b8540d46,
        type: 3}
      propertyPath: message.Array.data[1]
      value: "Eres medio claro...y tambi\xE9n eres medio oscuro..."
      objectReference: {fileID: 0}
    - target: {fileID: 2298563219558475413, guid: 59d7a06f8b2320e4bbb6c395b8540d46,
        type: 3}
      propertyPath: message.Array.data[2]
      value: "\xBFY si eres EL balance? \xBFEl que podr\xE1 hablar con las diosas
        para que acabe con esta guerra?"
      objectReference: {fileID: 0}
    - target: {fileID: 2298563219558475413, guid: 59d7a06f8b2320e4bbb6c395b8540d46,
        type: 3}
      propertyPath: message.Array.data[3]
