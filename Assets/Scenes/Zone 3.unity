    - target: {fileID: 2298563219558475413, guid: 59d7a06f8b2320e4bbb6c395b8540d46,
        type: 3}
      propertyPath: dialogueText
      value: 
      objectReference: {fileID: 1922614463}
    - target: {fileID: 2298563219558475413, guid: 59d7a06f8b2320e4bbb6c395b8540d46,
        type: 3}
      propertyPath: dialoguePanel
      value: 
      objectReference: {fileID: 1922614464}
    - target: {fileID: 2298563219558475413, guid: 59d7a06f8b2320e4bbb6c395b8540d46,
        type: 3}
      propertyPath: message.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 2298563219558475413, guid: 59d7a06f8b2320e4bbb6c395b8540d46,
        type: 3}
      propertyPath: message.Array.data[0]
      value: "\xA1Yo soy Maozen, guardi\xE1n de estos mu\xF1ecos de nieve!"
      objectReference: {fileID: 0}
    - target: {fileID: 2298563219558475413, guid: 59d7a06f8b2320e4bbb6c395b8540d46,
        type: 3}
      propertyPath: message.Array.data[1]
      value: "Te contar\xE9 una cosita: \xBFser\xE1 verdad o mentira?"
      objectReference: {fileID: 0}
    - target: {fileID: 2298563219558475413, guid: 59d7a06f8b2320e4bbb6c395b8540d46,
        type: 3}
      propertyPath: message.Array.data[2]
      value: "Ah\xED va: \xA1Vivimos en una simulaci\xF3n! \xA1Somos unos y ceros!
        \xA1S\xC1CAME DE AQU\xCD!"
      objectReference: {fileID: 0}
    - target: {fileID: 2298563219558475413, guid: 59d7a06f8b2320e4bbb6c395b8540d46,
        type: 3}
      propertyPath: message.Array.data[3]
      value: "\xA1Adelante! Ya casi no queda nada."
      objectReference: {fileID: 0}
    - target: {fileID: 4763180460756662808, guid: 59d7a06f8b2320e4bbb6c395b8540d46,
        type: 3}
      propertyPath: m_Name
      value: Maozen
      objectReference: {fileID: 0}
    - target: {fileID: 5283258684578406562, guid: 59d7a06f8b2320e4bbb6c395b8540d46,
        type: 3}
      propertyPath: m_LocalPosition.x
      value: 333.8
      objectReference: {fileID: 0}
