      value: 
      objectReference: {fileID: 1329424527}
    - target: {fileID: 7629302584185032616, guid: 7911768a63052254fafce981adceeb8a,
        type: 3}
      propertyPath: message.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 7629302584185032616, guid: 7911768a63052254fafce981adceeb8a,
        type: 3}
      propertyPath: message.Array.data[0]
      value: "\xA1Wow! No me puedo creer que vayamos a comenzar esta aventura.\r"
      objectReference: {fileID: 0}
    - target: {fileID: 7629302584185032616, guid: 7911768a63052254fafce981adceeb8a,
        type: 3}
      propertyPath: message.Array.data[1]
      value: "\xA1En fin, vayamos al grano! Cuando nos desterraron, pusieron una
        muralla para que evit\xE1semos salir de aqu\xED."
      objectReference: {fileID: 0}
    - target: {fileID: 7629302584185032616, guid: 7911768a63052254fafce981adceeb8a,
        type: 3}
      propertyPath: message.Array.data[2]
      value: "Pero creo que dejaron una llave para abrirla. \xA1Vayamos a buscarla!"
      objectReference: {fileID: 0}
    - target: {fileID: 7629302584185032616, guid: 7911768a63052254fafce981adceeb8a,
        type: 3}
      propertyPath: message.Array.data[3]
      value: "Estos caminos llevan a una mazmorra. \xA1Seguro que estar\xE1 por ah\xED!"
      objectReference: {fileID: 0}
    - target: {fileID: 7629302584185032616, guid: 7911768a63052254fafce981adceeb8a,
        type: 3}
      propertyPath: message.Array.data[4]
      value: "\rQuiz\xE1s puedas ayudarnos. \xBFQu\xE9 dices si lo hablamos con un
        trote? \xA1Intenta salir de este laberinto! \n"
      objectReference: {fileID: 0}
    - target: {fileID: 7629302584185032616, guid: 7911768a63052254fafce981adceeb8a,
        type: 3}
      propertyPath: message.Array.data[5]
      value: '[PULSA LAS TECLAS AWSD PARA MOVERTE]'
      objectReference: {fileID: 0}
