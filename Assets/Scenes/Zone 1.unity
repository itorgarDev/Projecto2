    - target: {fileID: 7824298905685332637, guid: 1b46ba543877b484ea0c973b5b81c757,
        type: 3}
      propertyPath: dialogueText
      value: 
      objectReference: {fileID: 1329424526}
    - target: {fileID: 7824298905685332637, guid: 1b46ba543877b484ea0c973b5b81c757,
        type: 3}
      propertyPath: characterType
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 7824298905685332637, guid: 1b46ba543877b484ea0c973b5b81c757,
        type: 3}
      propertyPath: dialoguePanel
      value: 
      objectReference: {fileID: 1329424527}
    - target: {fileID: 7824298905685332637, guid: 1b46ba543877b484ea0c973b5b81c757,
        type: 3}
      propertyPath: message.Array.data[0]
      value: "\"...El caos de este mundo no se acaba con m\xE1s caos, sino con el
        balance\"... \xA1Qu\xE9 dram\xE1tico es Maostiao aveces! Jijiji."
      objectReference: {fileID: 0}
    - target: {fileID: 7824298905685332637, guid: 1b46ba543877b484ea0c973b5b81c757,
        type: 3}
      propertyPath: message.Array.data[1]
      value: "Pero bueno, \xA1vayamos al grano!  Desde que sent\xED tu llegada, supe
        que hay algo especial en ti, que vienes a traer de vuelta el balance a estas
        tierras."
      objectReference: {fileID: 0}
    - target: {fileID: 7824298905685332637, guid: 1b46ba543877b484ea0c973b5b81c757,
        type: 3}
      propertyPath: message.Array.data[2]
      value: "Pero vayamos a un mejor lugar. \xA1Te esperar\xE9 en el templo para
        que te cuente m\xE1s!"
      objectReference: {fileID: 0}
