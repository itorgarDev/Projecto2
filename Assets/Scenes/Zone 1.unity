    - target: {fileID: 7629302584185032616, guid: 7911768a63052254fafce981adceeb8a,
        type: 3}
      propertyPath: message.Array.data[0]
      value: "\xA1Wow! \xA1Qu\xE9 velocidad! Casi me tropiezo... \xA1Pero se puede
        ir m\xE1s r\xE1pido!"
      objectReference: {fileID: 0}
    - target: {fileID: 7629302584185032616, guid: 7911768a63052254fafce981adceeb8a,
        type: 3}
      propertyPath: message.Array.data[1]
      value: "\xA1D\xE9jate llevar por la brisa! Ya ver\xE1s lo lejos que llegas.
        \xBFPor qu\xE9 no subes esa rampa as\xED?"
      objectReference: {fileID: 0}
    - target: {fileID: 7629302584185032616, guid: 7911768a63052254fafce981adceeb8a,
        type: 3}
      propertyPath: message.Array.data[2]
      value: "[PULSA LAS TECLA DEL ESPACIO O EL BOT\xD3N \"A\" PARA HACER DASH]"
      objectReference: {fileID: 0}
    - target: {fileID: 7629302584185032616, guid: 7911768a63052254fafce981adceeb8a,
        type: 3}
      propertyPath: message.Array.data[3]
      value: '[PULSA LAS TECLAS AWSD PARA MOVERTE]'
      objectReference: {fileID: 0}
